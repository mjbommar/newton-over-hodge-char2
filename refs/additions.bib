  title  = {{E}kedahl--{O}ort types of {$\mathbb{Z}/2\mathbb{Z}$}-covers in characteristic {$2$}},
  year   = {2025},
  eprint = {2511.02733},
  archivePrefix = {arXiv},
  primaryClass  = {math.NT},
  note   = {Preprint}
}

